distro == debian -> optimize_debian
distro == ubuntu -> optimize_ubuntu
distro == mint -> optimize_mint
distro == fedora -> optimize_fedora
distro == popos -> optimize_popos
distro == neon -> optimize_neon
distro == zorin -> optimize_zorin
distro == elementary -> optimize_elementary
distro == mxlinux -> optimize_mxlinux
distro == nobara -> optimize_nobara
distro == arch -> optimize_arch
distro == opensuse -> optimize_opensuse
distro == rocky -> optimize_rocky
distro == almalinux -> optimize_almalinux
